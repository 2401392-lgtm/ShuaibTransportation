@model IReadOnlyList<Route>
@{ ViewData["Title"] = "Routes"; }

<div class="page-head">
    <h1>Routes</h1>
    <a class="btn" asp-action="Create">New route</a>
</div>

<table class="table">
    <thead><tr><th>From</th><th>To</th><th>Distance</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Origin</td><td>@r.Destination</td><td>@r.DistanceKm km</td>
            <td>@(r.IsActive ? "Yes" : "No")</td>
            <td class="actions">
                <a asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="inline"
                      onsubmit="return confirm('Delete this route?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
