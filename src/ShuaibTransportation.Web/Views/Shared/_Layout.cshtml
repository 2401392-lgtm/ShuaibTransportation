<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] • Shuaib Transportation</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">Shuaib <span>Transportation</span></a>
    <nav>
        <a asp-controller="Home" asp-action="Index">Search trips</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (User.IsInRole("Customer"))
            {
                <a asp-controller="Booking" asp-action="MyBookings">My bookings</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="AdminHome" asp-action="Index">Admin</a>
            }
            <span class="user">@User.Identity!.Name</span>
            <form method="post" asp-controller="Account" asp-action="Logout" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="link">Sign out</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Sign in</a>
            <a asp-controller="Account" asp-action="Register" class="btn small">Register</a>
        }
    </nav>
</header>

<main class="container">
    @if (TempData["Success"] is string ok) { <div class="alert success">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert error">@err</div> }
    @RenderBody()
</main>

<footer class="footer">
    <p>Shuaib Transportation • Booking &amp; Management System • KCA University</p>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
