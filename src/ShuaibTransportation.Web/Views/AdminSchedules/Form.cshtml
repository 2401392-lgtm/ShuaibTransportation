@model Schedule
@{ ViewData["Title"] = ViewData["Heading"]; }

<div class="card narrow">
    <h1>@ViewData["Heading"]</h1>
    <form method="post" asp-action="@ViewData["Action"]" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <label>Route <select asp-for="RouteId" asp-items="ViewBag.Routes"><option value="">— select —</option></select></label>
        <label>Vehicle <select asp-for="VehicleId" asp-items="ViewBag.Vehicles"><option value="">— select —</option></select></label>
        <label>Departure <input asp-for="DepartureTime" type="datetime-local"
               value="@Model.DepartureTime.ToString("yyyy-MM-ddTHH:mm")" /></label>
        <label>Price (KSh) <input asp-for="Price" type="number" step="0.01" min="0" /></label>
        <button type="submit" class="btn">Save</button>
        <a asp-action="Index" class="link">Cancel</a>
    </form>
</div>
