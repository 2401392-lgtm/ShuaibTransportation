@{ ViewData["Title"] = "Sign in"; }

<div class="card narrow">
    <h1>Sign in</h1>
    <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        @Html.AntiForgeryToken()
        <label>Email <input type="email" name="email" required autofocus /></label>
        <label>Password <input type="password" name="password" required /></label>
        <button type="submit" class="btn">Sign in</button>
    </form>
    <p class="muted small">Demo admin: <code>admin@shuaib.test / Admin#12345</code><br />
       Demo customer: <code>customer@shuaib.test / Customer#12345</code></p>
    <p><a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Create an account</a></p>
</div>
