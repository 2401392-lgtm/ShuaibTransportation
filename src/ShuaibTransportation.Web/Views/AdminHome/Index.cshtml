    <a class="card tile" asp-controller="AdminSchedules" asp-action="Index">
        <h3>Schedules</h3><p>Create and edit departures.</p>
    </a>
    <a class="card tile" asp-controller="AdminBookings" asp-action="Index">
        <h3>Bookings</h3><p>Monitor all passenger bookings.</p>
    </a>
</div>
